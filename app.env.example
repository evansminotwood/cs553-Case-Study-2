# Copy to app.env and fill in. app.env is gitignored — never commit the real one.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# Optional monitor overrides (set low to demo the alert/adaptive response):
# MONITOR_CPU_THRESHOLD=80
# MONITOR_MEM_THRESHOLD=80
# MONITOR_RECOVERY_MARGIN=10
# MONITOR_INTERVAL=5
# Server-side HF token for the API product (so no one has to paste one in the UI).
# Must be a token with "Make calls to Inference Providers" permission.
# HF_TOKEN=hf_xxx
